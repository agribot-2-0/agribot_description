<launch>
  <include file="$(find agribot_description)/launch/robot_description.xml" />

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
    <remap from="joint_state" to="/agribot_model/joint_states" />
    <param name="use_tf_static" value="false" />
  </node>

  <node name="joint_state_publisher" pkg="agribot_description" type="joint_state_publisher" />

</launch>
