<launch>

  <rosparam command="load" file="$(find agribot_common)/config/simulation/config.yaml" />

  <param name="robot_description" command="$(find xacro)/xacro '$(find agribot_description)/urdf/agribot.urdf.xacro'" />

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
    <param name="use_tf_static" value="false" />
  </node>

  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />
  
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find agribot_description)/rviz/model.rviz"
        required="true"
  />
</launch>
