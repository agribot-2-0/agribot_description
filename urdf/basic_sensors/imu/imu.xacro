<robot name="imu" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
    <!-- Basic sonar macro  -->
    <xacro:macro  name="imu" 
                  params="*origin
                          parent:=^
                          name:=^
                          robot_namespace:=^
                          topic:=^
                          hz:=^
                          accel_noise:=^
                          gyro_noise:=^
                          yaw_noise:=^
                          yaw_drift:=^
                          yaw_drift_freq:=^
                          ">
  
        <joint name="${name}_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}"/>
            <child link="${name}_link" />
        </joint>
        <link name="${name}_link"/>


        <gazebo>
            <plugin name="imu_controller" filename="libgazebo_imu.so">
                <updateRate> ${hz} </updateRate>
                <robotNamespace> ${robot_namespace} </robotNamespace>
                <bodyName> ${name}_link </bodyName>
                <frameId> ${name}_link </frameId>
                <topicName> ${topic} </topicName>
        
                <!-- General noise  -->
                <!-- If 0.0 [accel/rate/yaw]GaussianNoises are used -->
                <gaussianNoise>0.0</gaussianNoise>
        
                <!-- Accelerometer noise -->
                <accelOffset>0.0 0.0 0.0</accelOffset>
                <accelDrift>0.0 0.0 0.0</accelDrift>
                <accelDriftFrequency>0.0 0.0 0.0</accelDriftFrequency>
                <accelGaussianNoise> ${accel_noise} ${accel_noise} ${accel_noise} </accelGaussianNoise>
        
                <!-- Gyroscope noise -->
                <rateOffset>0.0 0.0 0.0</rateOffset>
                <rateDrift>0.0 0.0 0.0</rateDrift>
                <rateDriftFrequency>0.0 0.0 0.0</rateDriftFrequency>
                <rateGaussianNoise> ${gyro_noise} ${gyro_noise} ${gyro_noise} </rateGaussianNoise>
        
                <!-- Yaw noise -->
                <yawOffset>0.0</yawOffset>
                <yawDrift> ${yaw_drift} </yawDrift>
                <yawDriftFrequency> ${yaw_drift_freq} </yawDriftFrequency>
                <yawGaussianNoise> ${yaw_noise} </yawGaussianNoise>
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>
  