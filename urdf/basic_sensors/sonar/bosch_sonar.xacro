<robot name="bosch_sonar" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:property name="M_PI" value="3.1415926535897931" />
    <xacro:include filename="$(find agribot_description)/urdf/basic_sensors/sonar/sonar.xacro"/>
  
    <xacro:macro    name="bosch_sonar"
                    params="*origin
                            parent:=^
                            name:=^
                            topic:=^ 
                            hz:=^
                            visualize:=^
                            perception_plugins:=^
                            ">

        <!-- Call basic sonar and pass arguments -->
        <xacro:sonar parent="${parent}"
                        name="${name}"
                        topic="${topic}"
                        hz="${hz}"
                        >

            <xacro:insert_block name="origin" />
            
            <!-- Sensor specific arguments -->
            <!-- Generation 4 BOSCH sensor -->
            <xacro:property name="min_range"                value="0.15"/>
            <xacro:property name="max_range"                value="3"/>
            <xacro:property name="noise"                    value="0.001"/>
            <xacro:property name="min_horizontal_angle"     value="-${60.0*M_PI/180.0}"/>
            <xacro:property name="max_horizontal_angle"     value="${60.0*M_PI/180.0}"/>
            <xacro:property name="min_vertical_angle"       value="-${30.0*M_PI/180.0}"/>
            <xacro:property name="max_vertical_angle"       value="${30.0*M_PI/180.0}"/>
            <xacro:property name="resolution"               value="0.001"/>
            <xacro:property name="perception_plugins_arg"  value="${perception_plugins}"/>

            <!-- Generation 6 BOSCH sensor -->
            <!-- <xacro:property name="min_range"                value="0.15"/>
            <xacro:property name="max_range"                value="5.5"/>
            <xacro:property name="noise"                    value="0.001"/>
            <xacro:property name="min_horizontal_angle"     value="-${70.0*M_PI/180.0}"/>
            <xacro:property name="max_horizontal_angle"     value="${70.0*M_PI/180.0}"/>
            <xacro:property name="min_vertical_angle"       value="-${35.0*M_PI/180.0}"/>
            <xacro:property name="max_vertical_angle"       value="${35.0*M_PI/180.0}"/>
            <xacro:property name="resolution"               value="0.001"/> -->
        </xacro:sonar>
    </xacro:macro>
</robot>
