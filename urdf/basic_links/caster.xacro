<robot name="caster" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:property name="caster_lenght" value="0.02" />
    <xacro:property name="caster_width" value="0.02" />
    <xacro:property name="caster_height" value="0.035" />

    <xacro:macro name="agribot_caster" params="name">
        <link name="${name}">
          <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${caster_lenght} ${caster_width} ${caster_height}" />
            </geometry>
            <material name="blue"/>
          </visual>

          <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="${caster_lenght} ${caster_width} ${caster_height}" />
            </geometry>
          </collision>

          <inertial>
            <origin xyz="0 0 0" />
            <mass value="0.01" />
            <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                     iyy="0.001" iyz="0.0"
                     izz="0.001" />
          </inertial>
        </link>
    </xacro:macro>

</robot>
