<robot name="tpl_assembled" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:property name="tpl_rev_hit_effector_len" value="0.55" />
    <xacro:property name="tpl_rev_hit_effector_wid" value="${3.5*tpl_base_hei}" />
    <xacro:property name="tpl_rev_hit_effector_hei" value="0.05" />
    <xacro:property name="tpl_rev_hit_effector_mass" value="0.001" />

    <xacro:macro name="agribot_tpl_revolute_hitch_effector" params="name">
      <link name="${name}">
        <visual>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_effector_right_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_effector_left_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_effector_right_link'}">
            <material name="green"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_effector_left_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <box size="0.0001 0.0001 0.0001"/>
          </geometry>
        </visual>

        <collision>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_effector_right_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_effector_left_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_effector_right_link'}">
            <material name="green"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_effector_left_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <box size="${tpl_rev_hit_effector_len} ${tpl_rev_hit_effector_wid} ${tpl_rev_hit_effector_hei}"/>
          </geometry>
        </collision>

        <inertial>
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
          <!-- Moments of inertia taken from-->
          <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors-->
          <mass value="${tpl_rev_hit_effector_mass}"/>
          <inertia ixx="${tpl_rev_hit_effector_mass*(tpl_rev_hit_effector_hei*tpl_rev_hit_effector_hei+tpl_rev_hit_effector_wid*tpl_rev_hit_effector_wid)/12}" ixy="0.0" ixz="0.0"
                   iyy="${tpl_rev_hit_effector_mass*(tpl_rev_hit_effector_len*tpl_rev_hit_effector_len+tpl_rev_hit_effector_hei*tpl_rev_hit_effector_hei)/12}" iyz="0.0"
                   izz="${tpl_rev_hit_effector_mass*(tpl_rev_hit_effector_len*tpl_rev_hit_effector_len+tpl_rev_hit_effector_wid*tpl_rev_hit_effector_wid)/12}" />
        </inertial>
      </link>
    </xacro:macro>

</robot>