<robot name="tpl_assembled" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="tpl_cyl_width" value="0.45" />
  <xacro:property name="tpl_cyl_radius" value="${tpl_base_hei/2}" />
  <xacro:property name="tpl_cyl_mass" value="0.001" />

  <xacro:macro name="agribot_tpl_cylinder" params="name">
    <link name="${name}">
      <visual>
        <xacro:if value="${name == 'back_tpl_cylinder_link'}">
          <origin xyz="1.84 -0.68 -0.1" rpy="${M_PI/10} ${M_PI/2} 0"/>
          <material name="white"/>
        </xacro:if>
        <xacro:if value="${name == 'front_tpl_cylinder_link'}">
          <origin xyz="-1.84 0.68 -0.1" rpy="${-M_PI+M_PI/10} ${M_PI/2} 0"/>
          <material name="green"/>
        </xacro:if>
        <geometry>
          <mesh filename="package://agribot_description/meshes/lower_hitches.stl" scale="0.00105 0.00105 0.00105"/>
        </geometry>
      </visual>

      <collision>
        <xacro:if value="${name == 'back_tpl_cylinder_link'}">
          <material name="white"/>
        </xacro:if>
        <xacro:if value="${name == 'front_tpl_cylinder_link'}">
          <material name="green"/>
        </xacro:if>
        <geometry>
          <cylinder length="${tpl_cyl_width}" radius="${tpl_cyl_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <!-- Moments of inertia taken from-->
        <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors-->
        <mass value="${tpl_cyl_mass}"/>
          <inertia ixx="${tpl_cyl_mass*(3*tpl_cyl_radius*tpl_cyl_radius+tpl_cyl_width*tpl_cyl_width)/12}" ixy="0.0" ixz="0.0"
                   iyy="${tpl_cyl_mass*(3*tpl_cyl_radius*tpl_cyl_radius+tpl_cyl_width*tpl_cyl_width)/12}" iyz="0.0"
                   izz="${tpl_cyl_mass*(tpl_cyl_radius*tpl_cyl_radius)/2}" />
      </inertial>
    </link>
  </xacro:macro>

</robot>