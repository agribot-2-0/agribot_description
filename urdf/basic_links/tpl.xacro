          <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors-->
          <mass value="${tpl_base_mass}"/>
          <inertia ixx="0.0" ixy="0.0" ixz="0.0"
                   iyy="0.0" iyz="0.0"
                   izz="0.0" />
        </inertial>
      </link>
    </xacro:macro>


    <xacro:macro name="agribot_tpl_upper_hitch_cylinder" params="name">
      <link name="${name}">
        <visual>
          <xacro:if value="${name == 'back_tpl_upper_hitch_cylinder_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_upper_hitch_cylinder_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <cylinder length="${tpl_upper_hit_base_cyl_width}" radius="${tpl_upper_hit_base_cyl_radius}"/>
          </geometry>
        </visual>

        <collision>
          <xacro:if value="${name == 'back_tpl_upper_hitch_cylinder_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_upper_hitch_cylinder_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <cylinder length="${tpl_upper_hit_base_cyl_width}" radius="${tpl_upper_hit_base_cyl_radius}"/>
          </geometry>
        </collision>

        <inertial>
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
          <!-- Moments of inertia taken from-->
          <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors-->
          <mass value="${tpl_cyl_mass}"/>
          <inertia ixx="0.0" ixy="0.0" ixz="0.0"
                   iyy="0.0" iyz="0.0"
                   izz="0.0" />
        </inertial>
      </link>
    </xacro:macro>


    <xacro:macro name="agribot_tpl_upper_hitch_prism_joint_base" params="name">
      <link name="${name}">
        <visual>
          <xacro:if value="${name == 'back_tpl_upper_hitch_prism_joint_base_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_upper_hitch_prism_joint_base_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <box size="${tpl_upper_hitch_prism_base_len} ${tpl_upper_hitch_prism_base_wid} ${tpl_upper_hitch_prism_base_hei}"/>
          </geometry>
        </visual>

        <collision>
          <xacro:if value="${name == 'back_tpl_upper_hitch_prism_joint_base_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_upper_hitch_prism_joint_base_link'}">
