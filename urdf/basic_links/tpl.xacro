<robot name="tpl" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:property name="tpl_base_len" value="0.43" />
    <xacro:property name="tpl_base_wid" value="0.3" />
    <xacro:property name="tpl_base_hei" value="0.05" />
    <xacro:property name="tpl_base_mass" value="300" />
    <xacro:property name="tpl_cyl_width" value="0.45" />
    <xacro:property name="tpl_cyl_radius" value="${tpl_base_hei/2}" />
    <xacro:property name="tpl_cyl_mass" value="50" />
    
    <xacro:property name="tpl_rev_hit_base_len" value="0.3" />
    <xacro:property name="tpl_rev_hit_base_wid" value="${2*tpl_base_hei}" />
    <xacro:property name="tpl_rev_hit_base_hei" value="0.05" />

    <xacro:property name="tpl_rev_hit_effector_len" value="0.5" />
    <xacro:property name="tpl_rev_hit_effector_wid" value="${2*tpl_base_hei}" />
    <xacro:property name="tpl_rev_hit_effector_hei" value="0.05" />
    
    <xacro:property name="tpl_upper_hit_base_len" value="0.66" />
    <xacro:property name="tpl_upper_hit_base_wid" value="0.3" />
    <xacro:property name="tpl_upper_hit_base_hei" value="0.05" />
    <xacro:property name="tpl_upper_hit_base_cyl_width" value="${tpl_upper_hit_base_wid}" />
    <xacro:property name="tpl_upper_hit_base_cyl_radius" value="${tpl_cyl_radius}" />
    <xacro:property name="tpl_upper_hit_base_cyl_mass" value="10" />
    <xacro:property name="tpl_upper_hitch_prism_base_len" value="0.5" />
    <xacro:property name="tpl_upper_hitch_prism_base_wid" value="0.075" />
    <xacro:property name="tpl_upper_hitch_prism_base_hei" value="0.075" />
    <xacro:property name="tpl_upper_hitch_prism_core_len" value="0.5" />
    <xacro:property name="tpl_upper_hitch_prism_core_wid" value="0.05" />
    <xacro:property name="tpl_upper_hitch_prism_core_hei" value="0.05" />

    <xacro:macro name="agribot_tpl_base" params="name">
      <link name="${name}">
        <visual>
          <xacro:if value="${name == 'back_tpl_base_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_base_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <box size="${tpl_base_len} ${tpl_base_wid} ${tpl_base_hei}"/>
          </geometry>
        </visual>

        <collision>
          <xacro:if value="${name == 'back_tpl_base_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_base_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <box size="${tpl_base_len} ${tpl_base_wid} ${tpl_base_hei}"/>
          </geometry>
        </collision>

        <inertial>
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
          <!-- Moments of inertia taken from-->
          <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors-->
          <mass value="${tpl_base_mass}"/>
          <inertia ixx="0.0" ixy="0.0" ixz="0.0"
                   iyy="0.0" iyz="0.0"
                   izz="0.0" />
        </inertial>
      </link>
    </xacro:macro>


    <xacro:macro name="agribot_tpl_cylinder" params="name">
      <link name="${name}">
        <visual>
          <xacro:if value="${name == 'back_tpl_cylinder_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_cylinder_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <cylinder length="${tpl_cyl_width}" radius="${tpl_cyl_radius}"/>
          </geometry>
        </visual>

        <collision>
          <xacro:if value="${name == 'back_tpl_cylinder_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_cylinder_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <cylinder length="${tpl_cyl_width}" radius="${tpl_cyl_radius}"/>
          </geometry>
        </collision>

        <inertial>
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
          <!-- Moments of inertia taken from-->
          <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors-->
          <mass value="${tpl_cyl_mass}"/>
          <inertia ixx="0.0" ixy="0.0" ixz="0.0"
                   iyy="0.0" iyz="0.0"
                   izz="0.0" />
        </inertial>
      </link>
    </xacro:macro>


    <xacro:macro name="agribot_tpl_revolute_hitch_base" params="name">
      <link name="${name}">
        <visual>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_base_right_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_base_left_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_base_right_link'}">
            <material name="green"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_base_left_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <box size="${tpl_rev_hit_base_len} ${tpl_rev_hit_base_wid} ${tpl_rev_hit_base_hei}"/>
          </geometry>
        </visual>

        <collision>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_base_right_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_base_left_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_base_right_link'}">
            <material name="green"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_base_left_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <box size="${tpl_rev_hit_base_len} ${tpl_rev_hit_base_wid} ${tpl_rev_hit_base_hei}"/>
          </geometry>
        </collision>

        <inertial>
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
          <!-- Moments of inertia taken from-->
          <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors-->
          <mass value="${tpl_base_mass}"/>
          <inertia ixx="0.0" ixy="0.0" ixz="0.0"
                   iyy="0.0" iyz="0.0"
                   izz="0.0" />
        </inertial>
      </link>
    </xacro:macro>


    <xacro:macro name="agribot_tpl_revolute_hitch_effector" params="name">
      <link name="${name}">
        <visual>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_effector_right_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_effector_left_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_effector_right_link'}">
            <material name="green"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_effector_left_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <box size="${tpl_rev_hit_effector_len} ${tpl_rev_hit_effector_wid} ${tpl_rev_hit_effector_hei}"/>
          </geometry>
        </visual>

        <collision>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_effector_right_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'back_tpl_revolute_hitch_effector_left_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_effector_right_link'}">
            <material name="green"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_revolute_hitch_effector_left_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <box size="${tpl_rev_hit_effector_len} ${tpl_rev_hit_effector_wid} ${tpl_rev_hit_effector_hei}"/>
          </geometry>
        </collision>

        <inertial>
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
          <!-- Moments of inertia taken from-->
          <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors-->
          <mass value="${tpl_base_mass}"/>
          <inertia ixx="0.0" ixy="0.0" ixz="0.0"
                   iyy="0.0" iyz="0.0"
                   izz="0.0" />
        </inertial>
      </link>
    </xacro:macro>


    <xacro:macro name="agribot_tpl_upper_hitch_base" params="name">
      <link name="${name}">
        <visual>
          <xacro:if value="${name == 'back_tpl_up_hit_base_link'}">
