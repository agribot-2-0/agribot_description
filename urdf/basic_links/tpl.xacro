<robot name="tpl" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:property name="tpl_width" value="0.25" />
    <xacro:property name="tpl_mass" value="500" />
    <xacro:property name="tpl_radius" value="500" />

        <xacro:macro name="agribot_tpl" params="name">
        <link name="${name}">
          <visual>
            <geometry>
              <cylinder length="${tpl_width}" radius="${tpl_radius}"/>
            </geometry>
          </visual>

          <collision>
            <geometry>
               <cylinder length="${tpl_width}" radius="${tpl_radius}"/>
            </geometry>
          </collision>

          <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <!-- Moments of inertia taken from-->
            <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors-->
            <mass value="${tpl_mass}"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0"
                     iyy="0.0" iyz="0.0"
                     izz="0.0}" />
          </inertial>
        </link>
    </xacro:macro>

</robot>