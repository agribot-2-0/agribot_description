          </geometry>
        </visual>

        <collision>
          <xacro:if value="${name == 'back_tpl_up_hit_base_link'}">
            <material name="white"/>
          </xacro:if>
          <xacro:if value="${name == 'front_tpl_up_hit_base_link'}">
            <material name="green"/>
          </xacro:if>
          <geometry>
            <box size="${tpl_upper_hit_base_len} ${tpl_upper_hit_base_wid} ${tpl_upper_hit_base_hei}"/>
          </geometry>
