<robot name="base" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:property name="base_lenght" value="0.2" />
    <xacro:property name="base_width" value="0.2" />
    <xacro:property name="base_height" value="0.01" />

    <xacro:macro name="agribot_base" params="name">
        <link name="${name}">
          <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <geometry>
               <box size="${base_lenght} ${base_width} ${base_height}" />
            </geometry>
            <material name="blue"/>
          </visual>

          <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <geometry>
              <box size="${base_lenght} ${base_width} ${base_height}"/>
            </geometry>
          </collision>

          <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <mass value="1"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                     iyy="0.01" iyz="0.0"
                     izz="0.01" />
          </inertial>
        </link>
    </xacro:macro>

</robot>
