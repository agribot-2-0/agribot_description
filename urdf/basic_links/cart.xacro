<robot name="base" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:include filename="$(find agribot_description)/urdf/basic_links/wheel.xacro"/>
    <xacro:include filename="$(find agribot_description)/urdf/basic_links/chassis.xacro"/>

    <xacro:property name="cart_lenght" value="${wheel_radius*2}" />
    <xacro:property name="cart_width" value="${chassis_width}" />
    <xacro:property name="cart_height" value="${wheel_radius*2}" />

    <xacro:macro name="agribot_cart" params="name">
        <link name="${name}">
          <visual>
            <xacro:if value="${name == 'back_cart_link'}">
              <origin xyz="${cart_width} 0.0 0.0" rpy="1.57 0 1.57"/>
            </xacro:if>
            <xacro:if value="${name == 'front_cart_link'}">
              <origin xyz="-${cart_width} 0.0 0.0" rpy="1.57 0 -1.57"/>
            </xacro:if>
            <geometry>
              <mesh filename="package://agribot_description/meshes/agribot_cart.dae" scale="1 1 1"/>
            </geometry>
          </visual>

          <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <geometry>
              <box size="${cart_lenght} ${cart_width} ${cart_height}"/>
            </geometry>
          </collision>

          <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <!-- <mass value="1"/> -->
            <mass value="1.00"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                     iyy="0.01" iyz="0.0"
                     izz="0.01" />
          </inertial>
        </link>
    </xacro:macro>

</robot>
