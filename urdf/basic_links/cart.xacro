<robot name="base" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:property name="cart_lenght" value="${wheel_radius*2}" />
    <xacro:property name="cart_width" value="${chassis_width}" />
    <xacro:property name="cart_height" value="${wheel_radius*2}" />
    <xacro:property name="cart_mass" value="500" />

    <xacro:macro name="agribot_cart" params="name">
        <link name="${name}">
          <visual>
            <xacro:if value="${name == 'back_cart_link'}">
              <origin xyz="1.155 0.1 0.092" rpy="${M_PI/2} 0 ${M_PI/2}"/>
              <material name="white"/>
            </xacro:if>
            <xacro:if value="${name == 'front_cart_link'}">
              <origin xyz="-1.155 -0.1 0.092" rpy="${M_PI/2} 0 ${-M_PI/2}"/>
              <material name="green"/>
            </xacro:if>
            <geometry>
              <mesh filename="package://agribot_description/meshes/agribot_cart.stl" scale="0.00105 0.00105 0.00105"/>
            </geometry>
          </visual>

          <collision>
            <xacro:if value="${name == 'back_cart_link'}">
              <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
              <material name="white"/>
            </xacro:if>
            <xacro:if value="${name == 'front_cart_link'}">
              <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
              <material name="green"/>
            </xacro:if>
            <geometry>
               <box size="${cart_lenght} ${cart_width} ${cart_height}" />
            </geometry>
          </collision>

          <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <!-- Moments of inertia taken from-->
            <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia#List_of_3D_inertia_tensors-->
            <mass value="${cart_mass}"/>
            <inertia ixx="${cart_mass*(cart_height*cart_height+cart_width*cart_width)/12}" ixy="0.0" ixz="0.0"
                     iyy="${cart_mass*(cart_lenght*cart_lenght+cart_height*cart_height)/12}" iyz="0.0"
                     izz="${cart_mass*(cart_lenght*cart_lenght+cart_width*cart_width)/12}" />
          </inertial>
        </link>
    </xacro:macro>

</robot>
