<robot name="perception_sensors" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find agribot_description)/urdf/perception_sensors/perception_suites/livox_zed2_set.xacro" />

  <xacro:macro name="perception_sensors" params="perception_plugins:=^
                     ">

    <!-- Lidars -->
    <xacro:livox_zed2_set>
      <origin xyz="1.15 0 2.05" rpy="0 ${28.9*M_PI/180.0} 0" />
      <xacro:property name="parent" value="base_footprint" />
      <xacro:property name="suite_name" value="front_livox_zed2_set" />
      <xacro:property name="livox_name" value="front_lidar" />
      <xacro:property name="livox_topic" value="/agribot/obstacle_detection/front/3d/lidar/point_cloud" />
      <xacro:property name="zed2_point_cloud_topic" value="/agribot/obstacle_detection/front/3d/stereo_camera/point_cloud" />
      <xacro:property name="zed2_image_topic" value="/zed2_node/rgb/image_rect_color" />
      <xacro:property name="zed2_image_camera_info_topic" value="/zed2_node/rgb/camera_info" />
      <xacro:property name="zed2_depth_image_topic" value="/zed2_node/stereo/image_rect_color" />
      <xacro:property name="zed2_depth_image_camera_info_topic" value="/zed2_node/stereo/camera_info" />
      <xacro:property name="livox_hz" value="1.0" />
      <xacro:property name="livox_visualize" value="false" />
    </xacro:livox_zed2_set>

  </xacro:macro>
</robot>