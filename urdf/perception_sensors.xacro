<robot name="perception_sensors" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find agribot_description)/urdf/perception_sensors/perception_suites/livox_zed2_set.xacro" />

  <xacro:macro name="perception_sensors" params="perception_plugins:=^
                     ">

    <!-- Lidars -->
    <xacro:livox_zed2_set>
      <origin xyz="1.47 0 0.98" rpy="0 ${25.0*M_PI/180.0} 0" />
      <xacro:property name="parent" value="front_cart_link" />
      <xacro:property name="suite_name" value="front_livox_zed2_set" />
      <xacro:property name="livox_name" value="front_lidar" />
      <xacro:property name="livox_topic" value="/agribot/obstacle_detection/front/3d/lidar/point_cloud" />
      <xacro:property name="livox_hz" value="1.0" />
      <xacro:property name="livox_visualize" value="false" />
    </xacro:livox_zed2_set>

  </xacro:macro>
</robot>