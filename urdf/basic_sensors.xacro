<robot name="sensors" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="$(find agribot_description)/urdf/basic_sensors/imu/imu_sensor.xacro"/>
    <xacro:include filename="$(find agribot_description)/urdf/basic_sensors/gps/gps.xacro"/>
    <xacro:include filename="$(find agribot_description)/urdf/basic_sensors/inclinometer/inclinometer.xacro"/>
    <xacro:include filename="$(find agribot_description)/urdf/basic_sensors/magnetometer/magnetometer.xacro"/>

    <xacro:macro name="basic_sensors">

        <xacro:property name="reference_latitude"   value="${param_simulation['simulation_latitude']}"/>
        <xacro:property name="reference_longitude"  value="${param_simulation['simulation_longitude']}"/>
        <xacro:property name="reference_heading"    value="${param_simulation['simulation_heading']}"/>
        <xacro:property name="reference_altitude"   value="${param_simulation['simulation_altitude']}"/>

        <xacro:imu_sensor>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <xacro:property name="parent"               value="chassis_link"/>
            <xacro:property name="topic"                value="agribot/imu/raw"/>
            <xacro:property name="name"                 value="imu"/>
            <xacro:property name="hz"                   value="10.0"/>

            <xacro:property name="accel_noise"          value="0.0"/>
            <xacro:property name="gyro_noise"           value="0.0"/>
        </xacro:imu_sensor>

        <xacro:gps>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <xacro:property name="parent"               value="chassis_link"/>
            <xacro:property name="robot_namespace"      value="agribot"/>
            <xacro:property name="topic"                value="gnss"/>
            <xacro:property name="velocity_topic"       value="fix_velocity"/>
            <xacro:property name="name"                 value="gps"/>
            <xacro:property name="hz"                   value="10.0"/>
            
            <xacro:property name="noise"                value="0.03"/>
            <xacro:property name="velocity_noise"       value="0.3"/>
            
            <!-- Use heading -->
            <xacro:property name="publish_heading"      value="true"/>
            <xacro:property name="heading_topic"        value="heading"/>
            <xacro:property name="heading_noise"        value="0.01"/>
        </xacro:gps>

        <xacro:inclinometer>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <xacro:property name="parent"               value="chassis_link"/>
            <xacro:property name="robot_namespace"      value="agribot"/>
            <xacro:property name="topic"                value="inclinometer"/>
            <xacro:property name="name"                 value="inclinometer"/>
            <xacro:property name="hz"                   value="10.0"/>

            <xacro:property name="noise"                value="0.01"/>
        </xacro:inclinometer>

        <xacro:magnetometer>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <xacro:property name="parent"               value="chassis_link"/>
            <xacro:property name="robot_namespace"      value="agribot"/>
            <xacro:property name="topic"                value="magnetic_field"/>
            <xacro:property name="name"                 value="magnetometer"/>
            <xacro:property name="hz"                   value="10.0"/>

            <xacro:property name="magnitude"            value="1.0"/>
            <xacro:property name="declination"          value="5.0741"/>
            <xacro:property name="inclination"          value="67.0937"/>
            <xacro:property name="noise"                value="1.1e-14"/>
            <!-- <xacro:property name="noise"                value="1.1e-8"/> -->
            <!-- <xacro:property name="noise"                value="1.1e-5"/> -->
        </xacro:magnetometer>

    </xacro:macro>
</robot>
