<robot name="sensors" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="$(find agribot_description)/urdf/basic_sensors/imu/imu_sensor.xacro"/>
    <xacro:include filename="$(find agribot_description)/urdf/basic_sensors/gps/gps.xacro"/>
    <xacro:include filename="$(find agribot_description)/urdf/basic_sensors/gps/dual_antenna_gps.xacro"/>
    <xacro:include filename="$(find agribot_description)/urdf/basic_sensors/inclinometer/inclinometer.xacro"/>
    <xacro:include filename="$(find agribot_description)/urdf/basic_sensors/magnetometer/magnetometer.xacro"/>

    <xacro:macro name="basic_sensors">

        <xacro:property name="chassis_to_imu_yaw" value="${M_PI/2}"/>

        <!-- NOTE: Simulation properties are passed in robot_description.xml file -->
        <!-- Position on Earth -->
        <xacro:property name="reference_latitude"   value="$(arg simulation_latitude)"/>
        <xacro:property name="reference_longitude"  value="$(arg simulation_longitude)"/>
        <xacro:property name="reference_altitude"   value="$(arg simulation_altitude)"/>

        <!-- Magnetometer simulation plugin -->
        <xacro:property name="declination"   value="$(arg simulation_declination)"/>
        <xacro:property name="inclination"   value="$(arg simulation_inclination)"/>

        <xacro:dual_antenna_gps>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <xacro:property name="parent"               value="chassis_link"/>
          <xacro:property name="name"                 value="bynav"/>
          <xacro:property name="robot_namespace"      value="agribot"/>
          <xacro:property name="topic"                value="gnss/bynav"/>
          <xacro:property name="velocity_topic"       value="gnss_velocity/bynav"/>
          <xacro:property name="hz"                   value="10.0"/>

          <xacro:property name="reference_heading"  value="${$(arg simulation_heading)}"/>

          <xacro:property name="noise"                value="$(arg simulation_gps_noise)"/>
          <xacro:property name="velocity_noise"       value="$(arg simulation_gps_velocity_noise)"/> -->

          <xacro:property name="heading_topic"        value="heading/bynav"/>
          <xacro:property name="heading_noise"        value="$(arg simulation_gps_heading_noise)"/>
        </xacro:dual_antenna_gps>

        <xacro:dual_antenna_gps>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <xacro:property name="parent"               value="chassis_link"/>
          <xacro:property name="name"                 value="hydrabox"/>
          <xacro:property name="robot_namespace"      value="agribot"/>
          <xacro:property name="topic"                value="gnss/hydrabox"/>
          <xacro:property name="velocity_topic"       value="gnss_velocity/hydrabox"/>
          <xacro:property name="hz"                   value="10.0"/>

          <xacro:property name="reference_heading"  value="${$(arg simulation_heading)}"/>

          <xacro:property name="noise"                value="$(arg simulation_gps_noise)"/>
          <xacro:property name="velocity_noise"       value="$(arg simulation_gps_velocity_noise)"/>

          <xacro:property name="heading_topic"        value="heading/hydrabox"/>
          <xacro:property name="heading_noise"        value="$(arg simulation_gps_heading_noise)"/>
        </xacro:dual_antenna_gps>

        <xacro:imu_sensor>
            <origin xyz="0 0 0" rpy="0 0 ${chassis_to_imu_yaw}" />
            <xacro:property name="parent"               value="chassis_link"/>
            <xacro:property name="topic"                value="/agribot/imu/raw/data"/>
            <xacro:property name="name"                 value="imu"/>
            <xacro:property name="hz"                   value="10.0"/>

            <xacro:property name="accel_noise"          value="$(arg simulation_accelerometer_noise)"/>
            <xacro:property name="gyro_noise"           value="$(arg simulation_gyroscope_noise)"/>
        </xacro:imu_sensor>

        <xacro:gps>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <xacro:property name="parent"               value="chassis_link"/>
            <xacro:property name="robot_namespace"      value="agribot"/>
            <xacro:property name="topic"                value="gnss"/>
            <xacro:property name="velocity_topic"       value="fix_velocity"/>
            <xacro:property name="name"                 value="gps"/>
            <xacro:property name="hz"                   value="10.0"/>

            <xacro:property name="reference_heading"  value="${$(arg simulation_heading)}"/>

            <xacro:property name="noise"                value="$(arg simulation_gps_noise)"/>
            <xacro:property name="velocity_noise"       value="$(arg simulation_gps_velocity_noise)"/>

            <!-- Use heading -->
            <xacro:property name="publish_heading"      value="$(arg simulation_gps_publish_heading)"/>
            <xacro:property name="heading_topic"        value="heading"/>
            <xacro:property name="heading_noise"        value="$(arg simulation_gps_heading_noise)"/>
        </xacro:gps>

        <xacro:inclinometer>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <xacro:property name="parent"               value="chassis_link"/>
            <xacro:property name="robot_namespace"      value="agribot"/>
            <xacro:property name="topic"                value="inclinometer"/>
            <xacro:property name="name"                 value="inclinometer"/>
            <xacro:property name="hz"                   value="10.0"/>

            <xacro:property name="noise"                value="$(arg simulation_inclinometer_noise)"/>
        </xacro:inclinometer>

        <xacro:magnetometer>
            <origin xyz="0 0 0" rpy="0 0 ${chassis_to_imu_yaw}" />
            <xacro:property name="parent"               value="chassis_link"/>
            <xacro:property name="robot_namespace"      value="agribot"/>
            <xacro:property name="topic"                value="imu/raw/mag"/>
            <xacro:property name="name"                 value="magnetometer"/>
            <xacro:property name="hz"                   value="10.0"/>

            <xacro:property name="reference_heading"  value="${$(arg simulation_heading) - degrees(chassis_to_imu_yaw)}"/>

            <xacro:property name="magnitude"            value="$(arg simulation_magnetometer_magnitude)"/>
            <xacro:property name="noise"                value="$(arg simulation_magnetometer_noise)"/>
        </xacro:magnetometer>

    </xacro:macro>
</robot>
