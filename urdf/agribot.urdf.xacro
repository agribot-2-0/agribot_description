<?xml version="1.0" ?>
<robot name="agribot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find agribot_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/agribot.gazebo"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/cart.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/wheel.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/support.xacro"/>
  <link name="base_footprint"/>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="chassis_link" />
    <origin xyz="0 0 ${3*wheel_radius+chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <xacro:agribot_chassis name="chassis_link" />

  <joint name="front_cart_joint" type="revolute">
    <parent link="chassis_link"/>
    <child link="front_cart_link"/>
    <limit lower="${-M_PI/4}" upper="${M_PI/4}" effort="1000.0" velocity="1000.0"/>
    <origin xyz="${(chassis_length/2)-cart_lenght/2} 0.0 ${(chassis_height+cart_height)/(-2)}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_cart name="front_cart_link" />

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_cart_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.0 ${(chassis_width+wheel_width)/2} ${-wheel_radius}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="front_left_wheel_link" />

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_cart_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.0 ${-(chassis_width+wheel_width)/2} ${-wheel_radius}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="front_right_wheel_link" />

  <joint name="back_cart_joint" type="revolute">
    <parent link="chassis_link"/>
    <child link="back_cart_link"/>
    <limit lower="${-M_PI/4}" upper="${M_PI/4}"  effort="1000.0" velocity="1000.0"/>
    <origin xyz="${-(chassis_length/2)+cart_lenght/2} 0.0 ${(chassis_height+cart_height)/(-2)}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_cart name="back_cart_link" />

  <joint name="back_left_wheel_joint" type="continuous">
    <parent link="back_cart_link"/>
    <child link="back_left_wheel_link"/>
    <origin xyz="0.0 ${(chassis_width+wheel_width)/2} ${-wheel_radius}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="back_left_wheel_link" />

  <joint name="back_right_wheel_joint" type="continuous">
    <parent link="back_cart_link"/>
    <child link="back_right_wheel_link"/>
    <origin xyz="0.0 ${-(chassis_width+wheel_width)/2} ${-wheel_radius}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="back_right_wheel_link" />

  <gazebo>
    <plugin name="agribot_controller" filename="libgazebo_ros_agribot.so">
      <wheelSeparation> ${chassis_width+wheel_width} </wheelSeparation>
      <wheelRadius> ${wheel_radius} </wheelRadius>
      <chasisLength>${chassis_length-2*wheel_radius}</chasisLength>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="inclinometer_controller" filename="libgazebo_inclinometer.so">
      <inclinometerLink>"base_footprint"</inclinometerLink>
    </plugin>
  </gazebo>

  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo>  
    <plugin name="imu_cotroller" filename="libhector_gazebo_ros_imu.so">
      <updateRate>10</updateRate>
      <robotNamespace>simulation</robotNamespace>
      <bodyName>imu_link</bodyName>
      <frameId>imu_link</frameId>
      <topicName>imu</topicName>
      <rpyOffset>0 0 0</rpyOffset>
      <xyzOffset>0 0 0</xyzOffset>
      <gaussianNoise>0.00000001</gaussianNoise>
      <accelDrift>0.00000001 0.00000001 0.00000001</accelDrift>
      <accelDriftFrequency>0.00000001 0.00000001 0.00000001</accelDriftFrequency>
      <accelGaussianNoise>0.00000001 0.00000001 0.00000001</accelGaussianNoise>
      <rateDrift>0.0 0.0 0.0</rateDrift>
      <rateDriftFrequency>0.0 0.0 0.0</rateDriftFrequency>
      <rateGaussianNoise>0.0 0.0 0.0</rateGaussianNoise>
      <headingDrift>0.0 0.0 0.0</headingDrift>
      <headingDriftFrequency>0.0 0.0 0.0</headingDriftFrequency>
      <headingGaussianNoise>0.0 0.0 0.0</headingGaussianNoise>
    </plugin>
  </gazebo> 

  <link name="gps_link"/>

  <joint name="gps_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="gps_link" />
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo>  
    <plugin name="gps_controller" filename="libhector_gazebo_ros_gps.so">
      <updateRate>10.0</updateRate>
      <robotNamespace>simulation</robotNamespace>
      <bodyName>gps_link</bodyName>
      <frameId>gps_link</frameId>
      <topicName>fix</topicName>
      <velocityTopicName>fix_velocity</velocityTopicName>
      <drift>5.0 5.0 5.0</drift>
      <gaussianNoise>0.1 0.1 0.1</gaussianNoise>
      <velocityDrift>0 0 0</velocityDrift>
      <velocityGaussianNoise>0.1 0.1 0.1</velocityGaussianNoise>
    </plugin>
  </gazebo> 

  <link name="magnetic_link"/>

  <joint name="magnetic_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="magnetic_link" />
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo>  
    <plugin name="magnetic_controller" filename="libhector_gazebo_ros_magnetic.so">
      <updateRate>10.0</updateRate>
      <robotNamespace>simulation</robotNamespace>
      <bodyName>magnetic_link</bodyName>
      <topicName>magnetic_field</topicName>
      <drift>5.0 5.0 5.0</drift>
      <gaussianNoise>0.1 0.1 0.1</gaussianNoise>
      <velocityDrift>0 0 0</velocityDrift>
      <velocityGaussianNoise>0.1 0.1 0.1</velocityGaussianNoise>
    </plugin>
  </gazebo> 

</robot>
