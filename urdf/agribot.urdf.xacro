<?xml version="1.0" ?>
<robot name="agribot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find agribot_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_sensors.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/perception_sensors.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/tools_sensors.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/wheel.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/chassis.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/cart.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/tpl.xacro"/>

  <xacro:arg name="perception_sensors" default="false" />
  <xacro:arg name="perception_plugins" default="true" />


  <link name="base_footprint"/>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="chassis_link" />
    <origin xyz="0 0 ${(chassis_height/2)+(cart_height/2)+2*wheel_radius}" rpy="0 0 0"/>
  </joint>

  <xacro:agribot_chassis name="chassis_link" />

  <joint name="front_cart_joint" type="revolute">
    <parent link="chassis_link"/>
    <child link="front_cart_link"/>
    <limit lower="${-45*M_PI/180}" upper="${45*M_PI/180}" effort="1000.0" velocity="1000.0"/>
    <origin xyz="${(chassis_length/2)-cart_lenght/2} 0.0 ${(chassis_height+cart_height)/(-2)}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_cart name="front_cart_link" />

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_cart_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.0 ${(cart_width+wheel_width)/2} ${-cart_height/2}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="front_left_wheel_link" />

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_cart_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.0 ${-(cart_width+wheel_width)/2} ${-cart_height/2}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="front_right_wheel_link" />

  <joint name="back_cart_joint" type="revolute">
    <parent link="chassis_link"/>
    <child link="back_cart_link"/>
    <limit lower="${-45*M_PI/180}" upper="${45*M_PI/180}"  effort="1000.0" velocity="1000.0"/>
    <origin xyz="${-(chassis_length/2)+cart_lenght/2} 0.0 ${(chassis_height+cart_height)/(-2)}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_cart name="back_cart_link" />

  <joint name="front_tpl_joint" type="fixed">
    <parent link="front_cart_link"/>
    <child link="front_tpl_link"/>
    <origin xyz="${(cart_lenght+tpl_len)/2} 0.0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_tpl_base name="front_tpl_link" />

  <joint name="back_left_wheel_joint" type="continuous">
    <parent link="back_cart_link"/>
    <child link="back_left_wheel_link"/>
    <origin xyz="0.0 ${(cart_width+wheel_width)/2} ${-cart_height/2}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="back_left_wheel_link" />

  <joint name="back_right_wheel_joint" type="continuous">
    <parent link="back_cart_link"/>
    <child link="back_right_wheel_link"/>
    <origin xyz="0.0 ${-(cart_width+wheel_width)/2} ${-cart_height/2}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="back_right_wheel_link" />

  <joint name="back_tpl_joint" type="fixed">
    <parent link="back_cart_link"/>
    <child link="back_tpl_link"/>
    <origin xyz="${-(cart_lenght+tpl_len)/2} 0.0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_tpl_base name="back_tpl_link" />

  <joint name="back_tpl_cyl_joint" type="fixed">
    <parent link="back_tpl_link"/>
    <child link="back_tpl_cyl_link"/>
    <origin xyz="${-(cart_lenght+tpl_len)/2} 0.0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_tpl_cylinder name="back_tpl_cyl_link" />

 <gazebo>
    <plugin name="agribot_controller" filename="libgazebo_ros_agribot.so">
      <wheelSeparation> ${chassis_width+wheel_width} </wheelSeparation>
      <wheelRadius> ${wheel_radius} </wheelRadius>
      <chasisLength>${chassis_length-2*wheel_radius}</chasisLength>
      <broadcastTF>false</broadcastTF> <!-- set this paremeter to false when localization is used-->
      <odometryTopic>/agribot/odometry</odometryTopic>
      <encoderTopic>/agribot/encoder/caterpillar</encoderTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <updateRate>10.000000</updateRate>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="weather_station" filename="libgazebo_weather.so">
    </plugin>
  </gazebo>
  <!-- Load basic sensors -->
  <xacro:basic_sensors/>

  <!-- Load tools sensors -->
  <xacro:tools_sensors/>

  <!-- Load perception sensors -->
  <xacro:if value="$(arg perception_sensors)">
    <xacro:perception_sensors>
      <xacro:property name="perception_plugins_arg" value="$(arg perception_plugins)"/>
    </xacro:perception_sensors>
  </xacro:if>

</robot>
