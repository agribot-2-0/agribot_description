<?xml version="1.0" ?>
<robot name="agribot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find agribot_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/agribot.gazebo"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/base.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/wheel.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/caster.xacro"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <xacro:agribot_base name="base_link" />

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="${(base_lenght/2)-wheel_radius} ${(base_width+wheel_width)/2} 0.0" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="wheel_left_link" />

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="${(base_lenght/2)-wheel_radius} ${-(base_width+wheel_width)/2} 0.0" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="wheel_right_link" />

  <joint name="caster_back_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back"/>
    <origin xyz="${caster_lenght-(base_lenght/2)} 0.0 ${-(base_height+caster_height)/2}" rpy="0.0 0.0 0.0"/>
  </joint>

  <xacro:agribot_caster name="caster_back" />

</robot>
