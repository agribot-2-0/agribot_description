<?xml version="1.0" ?>
<robot name="agribot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find agribot_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/agribot.gazebo"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/cart.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/wheel.xacro"/>
  <xacro:include filename="$(find agribot_description)/urdf/basic_links/support.xacro"/>
  <link name="base_footprint"/>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="chassis_link" />
    <origin xyz="0 0 ${3*wheel_radius+chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <xacro:agribot_chassis name="chassis_link" />

  <joint name="front_cart_joint" type="revolute">
    <parent link="chassis_link"/>
    <child link="front_cart_link"/>
    <limit lower="${-M_PI/4}" upper="${M_PI/4}" effort="1000.0" velocity="1000.0"/>
    <origin xyz="${(chassis_length/2)-cart_lenght/2} 0.0 ${(chassis_height+cart_height)/(-2)}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_cart name="front_cart_link" />

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_cart_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.0 ${(chassis_width+wheel_width)/2} ${-wheel_radius}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="front_left_wheel_link" />

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_cart_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.0 ${-(chassis_width+wheel_width)/2} ${-wheel_radius}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="front_right_wheel_link" />

  <joint name="back_cart_joint" type="revolute">
    <parent link="chassis_link"/>
    <child link="back_cart_link"/>
    <limit lower="${-M_PI/4}" upper="${M_PI/4}"  effort="1000.0" velocity="1000.0"/>
    <origin xyz="${-(chassis_length/2)+cart_lenght/2} 0.0 ${(chassis_height+cart_height)/(-2)}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_cart name="back_cart_link" />

  <joint name="back_left_wheel_joint" type="continuous">
    <parent link="back_cart_link"/>
    <child link="back_left_wheel_link"/>
    <origin xyz="0.0 ${(chassis_width+wheel_width)/2} ${-wheel_radius}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="back_left_wheel_link" />

  <joint name="back_right_wheel_joint" type="continuous">
    <parent link="back_cart_link"/>
    <child link="back_right_wheel_link"/>
    <origin xyz="0.0 ${-(chassis_width+wheel_width)/2} ${-wheel_radius}" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:agribot_wheel name="back_right_wheel_link" />

  <gazebo>
    <plugin name="agribot_controller" filename="libgazebo_ros_agribot.so">
      <wheelSeparation> ${chassis_width+wheel_width} </wheelSeparation>
      <wheelRadius> ${wheel_radius} </wheelRadius>
    </plugin>
  </gazebo>

</robot>
