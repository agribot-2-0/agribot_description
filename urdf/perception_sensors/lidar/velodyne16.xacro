<robot name="velodyne16" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:property name="M_PI" value="3.1415926535897931" />
    <xacro:include filename="$(find agribot_description)/urdf/perception_sensors/lidar/velodyne.xacro"/>
  
    <xacro:macro    name="velodyne16"
                    params="*origin
                            parent:=^
                            name:=^
                            topic:=^ 
                            hz:=^
                            visualize:=^
                            ">

        <!-- Call basic velodyne lidar and pass arguments -->
        <xacro:velodyne parent="${parent}"
                        name="${name}"
                        topic="${topic}"
                        hz="${hz}"
                        >

            <xacro:insert_block name="origin" />
            
            <!-- Sensor specific arguments -->
            <xacro:property name="lasers"                   value="16"/>
            <xacro:property name="samples"                  value="1875"/>
            <xacro:property name="min_range"                value="0.9"/>
            <xacro:property name="max_range"                value="130.0"/>
            <xacro:property name="noise"                    value="0.008"/>
            <xacro:property name="min_horizontal_angle"     value="-${M_PI}"/>
            <xacro:property name="max_horizontal_angle"     value="${M_PI}"/>
            <xacro:property name="min_vertical_angle"       value="-${15.0*M_PI/180.0}"/>
            <xacro:property name="max_vertical_angle"       value="${15.0*M_PI/180.0}"/>
            <xacro:property name="resolution"               value="0.001"/>
        </xacro:velodyne>
    </xacro:macro>
</robot>
