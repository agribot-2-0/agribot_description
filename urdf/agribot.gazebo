<?xml version="1.0"?>
<robot name="agribot" xmlns:xacro="http://ros.org/wiki/xacro">


  <gazebo reference="chassis_link">
      <material>Gazebo/Green</material>
  </gazebo>

  <gazebo reference="front_left_wheel_link">
    <mu1>10</mu1>
    <mu2>10</mu2>
    <!-- <kp>1000000.0</kp>
    <kd>10.0</kd> -->
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Gray</material>
  </gazebo>

  <gazebo reference="front_right_wheel_link">
    <mu1>10</mu1>
    <mu2>10</mu2>
    <!-- <kp>1000000.0</kp>
    <kd>10.0</kd> -->
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Gray</material>
  </gazebo>

  <gazebo reference="back_left_wheel_link">
    <mu1>10</mu1>
    <mu2>10</mu2>
    <!-- <kp>1000000.0</kp>
    <kd>10.0</kd> -->
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Gray</material>
  </gazebo>

  <gazebo reference="back_right_wheel_link">
    <mu1>10</mu1>
    <mu2>10</mu2>
    <!-- <kp>1000000.0</kp>
    <kd>10.0</kd> -->
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Gray</material>
  </gazebo>

  <gazebo reference="front_cart_link">
    <material>Gazebo/Green</material>
    <!-- <mu1>0</mu1>
    <mu2>0</mu2> -->
  </gazebo>
  <gazebo reference="front_support_link">
    <material>Gazebo/White</material>
    <!-- <mu1>0</mu1>
    <mu2>0</mu2> -->
  </gazebo>

  <gazebo reference="back_cart_link">
    <material>Gazebo/white</material>
    <!-- <mu1>0</mu1>
    <mu2>0</mu2> -->
  </gazebo>
  <gazebo reference="back_support_link">
    <material>Gazebo/Black</material>
    <!-- <mu1>0</mu1>
    <mu2>0</mu2> -->
  </gazebo>

  <gazebo>
    <plugin name="agribot_controller" filename="libgazebo_ros_agribot.so">
      <wheelSeparation> ${chassis_width+wheel_width} </wheelSeparation>
      <wheelRadius> ${wheel_radius} </wheelRadius>
      <chasisLength>${chassis_length-2*wheel_radius}</chasisLength>
      <broadcastTF>false</broadcastTF> <!-- set this paremeter to false when localization is used-->
      <odometryTopic>/agribot/odometry</odometryTopic>
      <encoderTopic>/agribot/encoder/caterpillar</encoderTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <updateRate>10.000000</updateRate>
    </plugin>
  </gazebo>

  <gazebo>
      <plugin name="magnetic_controller" filename="libgazebo_magnetic.so">
        <updateRate>10.0</updateRate>
        <robotNamespace>agribot</robotNamespace>
        <bodyName>magnetic_link</bodyName>
        <frameId>magnetic_link</frameId>
        <topicName>magnetic_field</topicName>

        <!-- Magnetometer setup -->
        <magnitude>1.0</magnitude>
        <referenceHeading>158.5507847682035</referenceHeading>

        <!-- Parking Drzewna -->
        <declination>5.0741</declination>
        <inclination>67.0937</inclination>

        <!-- Magnetometer noise -->
        <offset>0.0 0.0 0.0</offset>
        <drift>0.0 0.0 0.0</drift>
        <driftFrequency>0.0 0.0 0.0</driftFrequency>
        <gaussianNoise>1.1e-14 1.1e-14 1.1e-14</gaussianNoise>
        <!-- <gaussianNoise>1.1e-8 1.1e-8 1.1e-8</gaussianNoise> -->
        <!-- <gaussianNoise>1.1e-5 1.1e-5 1.1e-5</gaussianNoise> -->

      </plugin>
  </gazebo>

  <gazebo>
      <plugin name="gps_controller" filename="libgazebo_gps.so">
        <updateRate>10.0</updateRate>
        <robotNamespace>agribot</robotNamespace>
        <bodyName>gps_link</bodyName>
        <frameId>gps_link</frameId>
        <topicName>gnss</topicName>
        <velocityTopicName>fix_velocity</velocityTopicName>

        <!-- Reference values -->
        <!-- Parking Drzewna v1 -->
        <!-- <referenceLatitude>51.26660265786908</referenceLatitude>
        <referenceLongitude>17.20328839075593</referenceLongitude> -->

        <!-- Parking Drzewna v2 -->
        <!-- <referenceLatitude>51.11356025945108</referenceLatitude> -->
        <!-- <referenceLongitude>17.019947648318876</referenceLongitude> -->

        <referenceLatitude>51.26662409135839</referenceLatitude>
        <referenceLongitude>17.20327894189977</referenceLongitude>
        <referenceHeading>158.5507847682035</referenceHeading>
        <referenceAltitude>193.7327916698572</referenceAltitude>

        <!-- GPS noise -->
        <offset>0.0 0.0 0.0</offset>
        <gaussianNoise>0.03 0.03 0.03</gaussianNoise>
        <drift>0.0 0.0 0.0</drift>
        <driftFrequency>0.0 0.0 0.0</driftFrequency>

        <!-- Velocity noise -->
        <velocityOffset>0.0 0.0 0.0</velocityOffset>
        <velocityGaussianNoise>0.3 0.3 0.3</velocityGaussianNoise>
        <velocityDrift>0.0 0.0 0.0</velocityDrift>
        <velocityDriftFrequency>0.0 0.0 0.0</velocityDriftFrequency>

        <!-- Flags -->
        <status>STATUS_FIX</status>
        <service>SERVICE_GPS</service>
      </plugin>
  </gazebo>

  <gazebo>
      <plugin name="heading_controller" filename="libgazebo_heading.so">
        <updateRate>10.0</updateRate>
        <robotNamespace>agribot</robotNamespace>
        <bodyName>gps_link</bodyName>
        <frameId>gps_link</frameId>
        <topicName>heading</topicName>

        <!-- Heading noise -->
        <Drift>0.0 0.0 0.0</Drift>
        <DriftFrequency>0.0 0.0 0.0</DriftFrequency>
        <GaussianNoise>0.01 0.01 0.01</GaussianNoise>
      </plugin>
  </gazebo>

  <gazebo>
      <plugin name="inclinometer_controller" filename="libgazebo_inclinometer.so">
        <updateRate>10.0</updateRate>
        <robotNamespace>agribot</robotNamespace>
        <bodyName>inclinometer_link</bodyName>
        <frameId>inclinometer_link</frameId>
        <topicName>inclinometer</topicName>

        <!-- Inclinometer noise -->
        <Drift>0.0 0.0 0.0</Drift>
        <DriftFrequency>0.0 0.0 0.0</DriftFrequency>
        <GaussianNoise>0.01 0.01 0.01</GaussianNoise>
      </plugin>
  </gazebo>


</robot>
